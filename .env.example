# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required only when DATA_SOURCE=supabase (server writes and cron)
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio free tier. Explanations fall back to a template when this is empty.
GEMINI_API_KEY=

# Protects /api/cron/* in production. Vercel sends it as a Bearer token.
CRON_SECRET=

# demo (default) keeps accounts in this server process.
# supabase uses the migration in supabase/migrations.
DATA_SOURCE=demo
